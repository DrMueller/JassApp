@using JassApp.Presentation.Shared.Infos
@using JassApp.Presentation.Shared.LoadingIndication
@using MudBlazor
@attribute [Route(Path)]

<Informations Entries="Infos"></Informations>
<LoadingIndicator IsLoading="IsLoading">
    <MudCard>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="4">
                    <MudNumericField @bind-Value="Punktwert" Label="Punktwert" Variant="Variant.Text" Min="0"/>
                    <MudCheckBox @bind-Value="IsJasstrainingslager">Jasstrainingslager</MudCheckBox>
                    <MudCheckBox @bind-Value="HasRoundedPunkte">Punkte runden</MudCheckBox>
                </MudItem>
                <MudItem xs="4">
                    <CoiffeurTypSelect OnSelectedTypChanged="f => SelectedTyp = f"></CoiffeurTypSelect>
                </MudItem>
                <MudItem xs="4">
                    @* ReSharper disable once CSharpWarnings::CS8604 *@
                    <SpielerSelect Label="Starter" OnSpielerChanged="s => StartSpieler = s" Spieler="@Spieler">
                    </SpielerSelect>
                </MudItem>
                <MudItem xs="12">
                    @* ReSharper disable once CSharpWarnings::CS8604 *@
                    <TeamConfiguration OnSpieler1Selected="HandleSpieler1Selected"
                                       OnSpieler2Selected="HandleSpieler2Selected"
                                       OnSpieler3Selected="HandleSpieler3Selected"
                                       OnSpieler4Selected="HandleSpieler4Selected"
                                       Spieler="@Spieler">
                    </TeamConfiguration>
                </MudItem>
                <MudItem xs="12" class="d-flex justify-end">
                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                        <MudButton OnClick="StartGameAsync">Start</MudButton>
                    </MudButtonGroup>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
</LoadingIndicator>
